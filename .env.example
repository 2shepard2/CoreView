# Copy to .env and fill in what you use. Blank = that feature is off, or set
# it in Studio -> Settings instead (address and key, tested before saving).
# Secrets never go here: they are files in ./secrets (see README). A service
# set here (or in ./secrets) is read-only on the Settings page.

# Your time zone (clock widgets, quiet hours, theme times).
TZ=America/New_York

# Where the two ports listen on the Docker host. 0.0.0.0 = every interface;
# use your host's LAN address (or 127.0.0.1 behind a local reverse proxy).
BIND_ADDRESS=0.0.0.0
DISPLAY_PORT=3216
ADMIN_PORT=3217

# Sign-in cookies are HTTPS-only by default. Set 0 only for a plain-HTTP
# test on your own network.
COOKIE_SECURE=1

# Home Assistant (entities, calendars, to-do lists, buttons). Token file: secrets/ha_token
HA_URL=

# Immich photo albums. API key file: secrets/immich_api_key
IMMICH_URL=

# Frigate camera pop-ups and "who came by" (no secret needed).
FRIGATE_URL=

# LED Matrix over MQTT (often Home Assistant's Mosquitto add-on), plain mqtt:// only.
# Password file: secrets/mqtt_password
MQTT_URL=
MQTT_USERNAME=
MQTT_TOPIC_ROOT=home/signage
# MQTT_CLIENT_ID=coreview-studio

# Terrarium homelab widget (optional, needs Prometheus + Proxmox exporters; see README).
PROMETHEUS_URL=
LAB_STORAGE_METRIC=
LAB_HOST_PATTERN=

# "Now showing" Jellyfin widget (optional). Its API key (Jellyfin Dashboard ->
# API Keys) goes in secrets/jellyfin_api_key.
JELLYFIN_URL=

# 1 = every connection is read-only on the Settings page (server files only).
SETTINGS_LOCK=0

# Only if you run more than one copy on the same Docker host.
# COMPOSE_PROJECT_NAME=coreview-studio
# CONTAINER_NAME=coreview-studio
